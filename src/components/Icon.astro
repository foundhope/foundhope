---
interface Props { name: 'instagram' | 'facebook' | 'email' | 'menu' | 'close' | 'coffee' | 'produce' | 'cow' | 'cheese' | 'wine' | 'train' | 'bus' | 'walk' | 'bike' | 'car' | 'phone' | 'pin'; size?: number; stroke?: number }
const { name, size = 20, stroke = 1.8 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.5" /></>}
  {name === 'facebook' && <path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h2.5l.5-4h-3V7a1 1 0 0 1 1-1h2z" />}
  {name === 'email' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'coffee' && <><path d="M4 9h13v5a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6z" /><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17" /><path d="M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3" /></>}
  {name === 'produce' && <><path d="M12 21V8" /><path d="M12 8c0-3 2-5 5-5 0 3-2 5-5 5z" /><path d="M12 8c0-3-2-5-5-5 0 3 2 5 5 5z" /><path d="M12 14c0-2.5 2-4.5 5-4.5 0 2.5-2 4.5-5 4.5z" /><path d="M12 14c0-2.5-2-4.5-5-4.5 0 2.5 2 4.5 5 4.5z" /></>}
  {name === 'cow' && <><path d="M7.6 8.4C7.6 7.6 8.3 7 9.1 7h5.8c.8 0 1.5.6 1.5 1.4l-.6 6.4" /><path d="M7.6 8.4l.6 6.4" /><path d="M8.6 14.8h6.8a2.4 2.4 0 0 1 0 4.8H8.6a2.4 2.4 0 0 1 0-4.8z" /><path d="M10.2 17.2h.01M13.8 17.2h.01" /><path d="M10.2 10.8h.01M13.8 10.8h.01" /><path d="M8.8 7.2C7 6.8 5.8 5.4 5.8 3.8M15.2 7.2c1.8-.4 3-1.8 3-3.4" /><path d="M7.7 9.3L3.6 9c.4 1.4 1.9 2.3 4.1 2.1M16.3 9.3l4.1-.3c-.4 1.4-1.9 2.3-4.1 2.1" /></>}
  {name === 'cheese' && <><path d="M3 11l14-6 4 6v7H3z" /><path d="M3 11h18" /><circle cx="8" cy="14.5" r="1.2" /><circle cx="15" cy="15" r="1" /></>}
  {name === 'wine' && <><path d="M7 3h10l-.5 6a4.5 4.5 0 0 1-9 0z" /><path d="M12 13.5V20" /><path d="M8.5 21h7" /><path d="M7.4 7h9.2" /></>}
  {name === 'train' && <><rect x="5" y="3" width="14" height="13" rx="3" /><path d="M5 10h14" /><circle cx="9" cy="13" r="0.6" /><circle cx="15" cy="13" r="0.6" /><path d="M8 20l2-4M16 20l-2-4" /></>}
  {name === 'bus' && <><rect x="4" y="3" width="16" height="14" rx="2" /><path d="M4 10h16" /><circle cx="8" cy="14" r="0.6" /><circle cx="16" cy="14" r="0.6" /><path d="M7 17v3M17 17v3" /></>}
  {name === 'walk' && <><circle cx="13" cy="4" r="1.6" /><path d="M10 21l2-6-2-3 1-5 3 3 3 1" /><path d="M14 15l2 6" /><path d="M11 7l-3 2-1 3" /></>}
