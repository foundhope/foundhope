  {name === 'car' && <><path d="M5 16V11l2-5h10l2 5v5" /><path d="M3 16h18v3H3z" /><path d="M5 11h14" /><circle cx="7.5" cy="13.5" r="0.6" /><circle cx="16.5" cy="13.5" r="0.6" /></>}
