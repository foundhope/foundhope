---
// The little "Open now · until 4:30pm" light. Worked out in the visitor's
// browser from the opening hours in Sanity, so it is right even between rebuilds.
import { getHours } from '../lib/content';

const hours = await getHours();
const DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const schedule = {
  week: Object.fromEntries(
    DAYS.map((d) => {
      const row = hours.regular.find((r) => r.dayCodes.includes(d));
      return [d, row ? [row.opens, row.closes] : null];
    }),
  ),
  special: Object.fromEntries(hours.special.map((x) => [x.date, x.closed ? null : [x.opens, x.closes]])),
};
---
<a href="/visit" class="opennow" data-opennow hidden>
  <span class="opennow__dot" aria-hidden="true"></span>
  <span data-opennow-text></span>
</a>

<script is:inline define:vars={{ schedule }}>
  (function () {
    function parts(d) {
      var f = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'long', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });
      var o = {};
      f.formatToParts(d).forEach(function (p) { o[p.type] = p.value; });
      return { day: o.weekday, date: o.year + '-' + o.month + '-' + o.day, time: (o.hour === '24' ? '00' : o.hour) + ':' + o.minute };
    }
    function hoursFor(p) {
      if (Object.prototype.hasOwnProperty.call(schedule.special, p.date)) return schedule.special[p.date];
      return schedule.week[p.day];
    }
    function t12(t) {
      var h = +t.slice(0, 2), m = t.slice(3);
      return (h % 12 || 12) + (m !== '00' ? ':' + m : '') + (h >= 12 ? 'pm' : 'am');
    }
    var now = new Date();
    var today = parts(now);
    var h = hoursFor(today);
    var text, open = false;
    if (h && today.time >= h[0] && today.time < h[1]) {
      open = true;
      text = 'Open now · until ' + t12(h[1]);
    } else if (h && today.time < h[0]) {
      text = 'Closed · opens at ' + t12(h[0]) + ' today';
    } else {
      for (var i = 1; i <= 7; i++) {
        var next = parts(new Date(now.getTime() + i * 864e5));
        var nh = hoursFor(next);
        if (nh) { text = 'Closed · opens ' + (i === 1 ? 'tomorrow' : next.day) + ' at ' + t12(nh[0]); break; }
      }
    }
    var el = document.querySelector('[data-opennow]');
    if (el && text) {
      el.querySelector('[data-opennow-text]').textContent = text;
      el.classList.toggle('is-open', open);
      el.hidden = false;
    }
  })();
</script>

<style>
  .opennow {
    display: inline-flex; align-items: center; gap: 10px; align-self: flex-start;
    padding: 8px 14px; font-size: 15px; font-weight: 700; text-decoration: none;
    background: var(--stone-2); color: var(--ink);
  }
  .opennow[hidden] { display: none; }
  .opennow__dot { width: 10px; height: 10px; border-radius: 50%; background: #9a958c; }
  .opennow.is-open { background: #e3f3e6; color: #14532d; }
  .opennow.is-open .opennow__dot { background: #1f9d48; box-shadow: 0 0 0 0 rgba(31, 157, 72, 0.5); animation: opennow-pulse 2.4s ease-out infinite; }
  @keyframes opennow-pulse {
    0% { box-shadow: 0 0 0 0 rgba(31, 157, 72, 0.5); }
    70%, 100% { box-shadow: 0 0 0 9px rgba(31, 157, 72, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .opennow.is-open .opennow__dot { animation: none; } }
</style>
