---
// Placeholder pages, so every address in the menu and in _redirects works
// from day one. Each one gets replaced by its real page as it's built.
import Layout from '../layouts/Layout.astro';
import ComingSoon from '../components/ComingSoon.astro';

export function getStaticPaths() {
  return [
    { params: { page: 'journal' }, props: { title: 'Journal' } },
    { params: { page: 'privacy' }, props: { title: 'Privacy and cookies' } },
  ];
}

const { title, note } = Astro.props;
---
<Layout title={title} noindex>
  <ComingSoon title={title} note={note} />
</Layout>
