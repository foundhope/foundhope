---
// Where Stripe sends customers after paying the deposit. The order details are
// fetched from Stripe in the browser, using the session id in the address.
import Layout from '../../layouts/Layout.astro';
import { getChristmas, getSettings } from '../../lib/content';

const xmas = await getChristmas();
const s = await getSettings();
---
<Layout title="Order placed" noindex>
  <section class="thanks">
    <div class="wrap thanks__inner">
      <span class="caps eyebrow">Christmas order</span>
      <h1 class="serif thanks__title" data-title>Thank you<span data-name></span></h1>
      <p class="thanks__lead" data-lead>Checking your payment…</p>

      <div class="card" data-card hidden>
        <dl class="facts">
          <div><dt class="caps">Collect</dt><dd data-collection></dd></div>
          <div><dt class="caps">Deposit paid</dt><dd data-deposit></dd></div>
          <div><dt class="caps">Approx balance on collection</dt><dd data-balance></dd></div>
        </dl>
        <h2 class="caps card__title">Your order</h2>
        <ul class="lines" data-lines></ul>
        <p class="card__note">A receipt is on its way to <strong data-email></strong>. Meat is sold by size, so we'll confirm the final weight and price before you collect.</p>
      </div>

      <div class="next">
        <p>Need to change something? Email <a href={`mailto:${xmas.ordersEmail ?? 'orders@foundhope.store'}`}>{xmas.ordersEmail ?? 'orders@foundhope.store'}</a> or call <a href={`tel:${s.phoneIntl}`}>{s.phone}</a>.{xmas.refundCutoffText && ` Cancel by ${xmas.refundCutoffText} for a full refund of your deposit.`}</p>
        <a href="/" class="btn">Back to the home page</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const id = new URLSearchParams(location.search).get('session_id');
  const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;
  const lead = $('[data-lead]');

  if (!id) {
    lead.textContent = "We couldn't find your order details here, but if you paid, your receipt email has everything.";
  } else {
    fetch(`/api/checkout/session?id=${encodeURIComponent(id)}`)
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((o) => {
        if (!o.paid) {
          lead.textContent = "Your payment hasn't come through yet. If you've just paid, refresh in a minute. If not, your order isn't placed.";
          return;
        }
        if (o.firstName) $('[data-name]').textContent = `, ${o.firstName}`;
        lead.textContent = 'Your Christmas order is placed and your deposit is paid.';
        $('[data-collection]').textContent = o.collection;
        $('[data-deposit]').textContent = o.deposit;
        $('[data-balance]').textContent = o.balance;
        $('[data-email]').textContent = o.email;
        const list = $('[data-lines]');
        for (const line of o.items as string[]) {
          const li = document.createElement('li');
          li.textContent = line.replace(/^(\d+) x /, '$1 × ');
          list.append(li);
        }
        $('[data-card]').hidden = false;
      })
      .catch(() => {
        lead.textContent = "We couldn't load your order details just now, but if you paid, your receipt email has everything.";
      });
  }
</script>

<style>
  .thanks { background: var(--stone); padding-block: clamp(64px, 9vw, 120px); }
  .thanks__inner { max-width: 760px; display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .thanks__title { font-size: clamp(48px, 6vw, 76px); }
  .thanks__lead { font-size: 20px; line-height: 1.5; color: var(--ink-soft); }
  .card { width: 100%; background: #fff; padding: clamp(22px, 4vw, 36px); display: flex; flex-direction: column; gap: 18px; }
  .card[hidden] { display: none; }
  .facts { margin: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .facts div { display: flex; flex-direction: column; gap: 4px; }
  .facts dt { font-size: 11px; color: var(--muted); }
  .facts dd { margin: 0; font-size: 18px; font-weight: 700; }
  .card__title { font-size: 13px; border-top: 1px solid var(--rule); padding-top: 18px; }
  .lines { list-style: none; margin: 0; padding: 0; }
  .lines li { padding: 10px 0; border-bottom: 1px solid var(--stone-2); font-size: 16px; }
  .card__note { font-size: 15px; color: var(--muted); line-height: 1.55; }
  .next { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; font-size: 16px; line-height: 1.6; }
</style>
