---
// All suppliers. Cards, order and what shows are edited in Sanity under "Suppliers".
import Layout from '../layouts/Layout.astro';
import SupplierCard from '../components/SupplierCard.astro';
import { getSuppliers, emphasis } from '../lib/content';

const suppliers = await getSuppliers();
---
<Layout
  title="Our suppliers"
  description="The small roasters, growers, bakers, farmers and winemakers behind Found Hope in Hither Green. Meet the people whose produce we serve and sell."
>
  <section class="shead">
    <div class="wrap shead__grid">
      <div class="shead__title-wrap">
        <span class="caps eyebrow">Our suppliers</span>
        <h1 class="serif shead__title" set:html={emphasis('The people behind *the produce*')} />
      </div>
      <div class="shead__text">
        <p>We only stock what we'd share with our own family and friends. That means knowing who grows it, bakes it, roasts it and rears it.</p>
        <dl class="shead__key">
          <div><dt class="caps tag">Served here</dt><dd>in our food and coffee</dd></div>
          <div><dt class="caps tag">Take home</dt><dd>on our shelves to buy</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="slist" aria-label="Suppliers">
    <div class="wrap">
      <ul class="slist__grid">
        {suppliers.map((sp) => <li><SupplierCard supplier={sp} tags /></li>)}
      </ul>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta__inner">
      <h2 class="serif cta__title" set:html={emphasis('Taste it *for yourself*')} />
      <div class="cta__buttons">
        <a href="/food-and-drink" class="btn cta__btn">Food &amp; Drink</a>
        <a href="/#visit" class="btn cta__btn cta__btn--ghost">Plan a visit</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .shead { padding-block: clamp(48px, 7vw, 96px) clamp(36px, 5vw, 64px); }
  .shead__grid { display: grid; gap: 28px; align-items: end; }
  .shead__title-wrap { display: flex; flex-direction: column; gap: 20px; }
  .shead__title { font-size: clamp(48px, 6.5vw, 84px); max-width: 10em; }
  .shead__text { display: flex; flex-direction: column; gap: 20px; font-size: 18px; line-height: 1.6; color: var(--ink-soft); max-width: 32em; }
  .shead__key { margin: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; font-size: 15px; color: var(--muted); }
  .shead__key div { display: flex; align-items: center; gap: 10px; }
  .shead__key dd { margin: 0; }
  .tag { font-size: 11px; padding: 6px 10px; border: 1.5px solid var(--ink); color: var(--ink); }
  @media (min-width: 1000px) {
    .shead__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: 64px; }
  }

  .slist { background: var(--stone); padding-block: var(--section); }
  .slist__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }

  .cta { background: var(--accent); color: #fff; padding-block: clamp(56px, 7vw, 88px); }
  .cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px 40px; }
  .cta__title { font-size: clamp(42px, 5vw, 60px); }
  .cta__buttons { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta__btn { background: #fff; color: var(--ink); }
  .cta__btn:hover { background: var(--stone-2); color: var(--ink); }
  .cta__btn--ghost { background: transparent; color: #fff; border: 1.5px solid #fff; }
  .cta__btn--ghost:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }
</style>
