---
// Visit. Hours come from "Opening hours", contact from "Notice banner and contact",
// and the intro, photo, getting here and good to know from "Visit page" in Sanity.
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { getVisit, getHours, getSettings, getChristmas, time12, emphasis } from '../lib/content';

const v = await getVisit();
const hours = await getHours();
const s = await getSettings();
const xmas = await getChristmas();

// The normal week, one row per day, so today can be picked out.
const DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const week = DAYS.map((day) => {
  const row = hours.regular.find((r) => r.dayCodes.includes(day));
  return { day, opens: row?.opens ?? null, closes: row?.closes ?? null, label: row ? row.label : 'Closed' };
});

// Handed to the little script that works out "Open now" in the visitor's browser.
const schedule = {
  week: Object.fromEntries(week.map((d) => [d.day, d.opens ? [d.opens, d.closes] : null])),
  special: Object.fromEntries(hours.special.map((x) => [x.date, x.closed ? null : [x.opens, x.closes]])),
};

const addressLine = `${s.address.street}, ${s.address.city} ${s.address.postcode}`;
const appleMaps = `https://maps.apple.com/?daddr=${encodeURIComponent(addressLine)}`;
const { lat, lng } = s.geo;
const f4 = (n: number) => n.toFixed(4);
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${f4(lng - 0.012)},${f4(lat - 0.005)},${f4(lng + 0.012)},${f4(lat + 0.005)}&layer=mapnik&marker=${lat},${lng}`;

const MODE: Record<string, { label: string; icon: 'train' | 'bus' | 'walk' | 'bike' | 'car' }> = {
  train: { label: 'By train', icon: 'train' },
  bus: { label: 'By bus', icon: 'bus' },
  walk: { label: 'On foot', icon: 'walk' },
  bike: { label: 'By bike', icon: 'bike' },
  car: { label: 'By car', icon: 'car' },
};
---
<Layout
  title="Visit us"
  description={`Found Hope, ${addressLine}. Opening hours, directions, and how to get here by train or bus. Coffee, food, wine and spirits in Hither Green.`}
>
  <!-- HERO: words on top, the street illustration full width underneath -->
  <section class="vhero">
    <div class="wrap vhero__grid">
      <div class="vhero__head">
        <span class="caps eyebrow">Visit</span>
        <h1 class="serif vhero__title" set:html={emphasis('Come and *say hello*')} />
        <address class="caps vhero__address">{s.address.street}<br />{s.address.city} {s.address.postcode}</address>
      </div>
      <div class="vhero__side">
        <p class="status" data-status hidden><span class="status__dot" aria-hidden="true"></span><span data-status-text></span></p>
        {v.intro && <p class="vhero__intro">{v.intro}</p>}
        <div class="vhero__buttons">
          <a href={s.directionsUrl} class="btn btn--accent" rel="noopener" target="_blank">Get directions</a>
          <a href={`tel:${s.phoneIntl}`} class="btn btn--ghost">Call {s.phone}</a>
        </div>
      </div>
    </div>
    {v.image && (
      <div class="vhero__art">
        <Photo src={v.image} widths={[800, 1200, 1600, 1891]} sizes="100vw" loading="eager" fetchpriority="high" />
      </div>
    )}
  </section>

  <!-- HOURS AND CONTACT -->
  <section class="info" aria-labelledby="hours-title">
    <div class="wrap info__grid">
      <div class="info__hours">
        <h2 id="hours-title" class="caps info__title">Opening hours</h2>
        <dl class="week">
          {week.map((d) => (
            <div class="week__row" data-day={d.day}>
              <dt>{d.day}<span class="caps week__today">Today</span></dt>
              <dd>{d.label}</dd>
            </div>
          ))}
        </dl>
        {hours.special.length > 0 && (
          <div class="special">
            <h3 class="caps special__title">Special opening hours</h3>
            <dl class="week">
              {hours.special.map((x) => (
                <div class="week__row" data-date={x.date}>
                  <dt>{x.label} <span class="special__when">{x.when}</span><span class="caps week__today">Today</span></dt>
                  <dd>{x.text}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>

      <div class="info__contact">
        <h2 class="caps info__title">Get in touch</h2>
        <ul class="contact">
          <li><Icon name="phone" /><a href={`tel:${s.phoneIntl}`}>{s.phone}</a></li>
          <li><Icon name="email" /><a href={`mailto:${s.email}`}>{s.email}</a></li>
          <li><Icon name="pin" /><span>{addressLine}</span></li>
        </ul>
        {xmas.live && (
          <p class="xnote">
            <span class="caps xnote__title">Christmas orders</span>
            Collect from the shop on {xmas.collectionText}. Questions? <a href={`mailto:${xmas.ordersEmail}`}>{xmas.ordersEmail}</a>
          </p>
        )}
        <div class="socials">
          <span class="caps socials__title">Follow us</span>
          <div class="socials__links">
            {s.socials.instagram && <a href={s.socials.instagram} rel="noopener" target="_blank" aria-label="Instagram"><Icon name="instagram" /></a>}
            {s.socials.facebook && <a href={s.socials.facebook} rel="noopener" target="_blank" aria-label="Facebook"><Icon name="facebook" /></a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAP -->
  <section class="map" aria-labelledby="map-title">
    <div class="wrap map__head">
      <h2 id="map-title" class="caps info__title">Find us</h2>
      <div class="map__links">
        <a href={s.directionsUrl} class="caps text-link" rel="noopener" target="_blank">Google Maps</a>
        <a href={appleMaps} class="caps text-link" rel="noopener" target="_blank">Apple Maps</a>
      </div>
    </div>
    <iframe class="map__frame" src={mapSrc} title={`Map showing Found Hope at ${addressLine}`} loading="lazy" referrerpolicy="no-referrer"></iframe>
    <p class="wrap map__credit">Map © <a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">OpenStreetMap</a> contributors</p>
  </section>

  <!-- GETTING HERE + GOOD TO KNOW -->
  {(v.gettingHere.length > 0 || v.goodToKnow.length > 0) && (
    <section class="here">
      <div class="wrap here__grid">
        {v.gettingHere.length > 0 && (
          <div>
            <h2 class="serif h-big here__title" set:html={emphasis('Getting *here*')} />
            <ul class="routes">
              {v.gettingHere.map((r) => (
                <li class="route">
                  <span class="route__icon"><Icon name={MODE[r.mode]?.icon ?? 'pin'} size={26} stroke={1.5} /></span>
                  <span class="caps route__label">{MODE[r.mode]?.label ?? 'Getting here'}</span>
                  <p>{r.text}</p>
                </li>
              ))}
            </ul>
          </div>
        )}
        {v.goodToKnow.length > 0 && (
          <div class="know">
            <h2 class="caps info__title">Good to know</h2>
            <ul class="know__list">{v.goodToKnow.map((g) => <li>{g}</li>)}</ul>
          </div>
        )}
      </div>
    </section>
  )}
</Layout>

<script is:inline define:vars={{ schedule }}>
  (function () {
    var DAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
    function parts(d) {
      var f = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'long', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });
      var o = {};
      f.formatToParts(d).forEach(function (p) { o[p.type] = p.value; });
      return { day: o.weekday, date: o.year + '-' + o.month + '-' + o.day, time: (o.hour === '24' ? '00' : o.hour) + ':' + o.minute };
    }
    function hoursFor(p) {
      if (Object.prototype.hasOwnProperty.call(schedule.special, p.date)) return schedule.special[p.date];
      return schedule.week[p.day];
    }
    function t12(t) {
      var h = +t.slice(0, 2), m = t.slice(3);
      return (h % 12 || 12) + (m !== '00' ? ':' + m : '') + (h >= 12 ? 'pm' : 'am');
    }
    var now = new Date();
    var today = parts(now);
    var h = hoursFor(today);
    var text, open = false;
    if (h && today.time >= h[0] && today.time < h[1]) {
      open = true;
      text = 'Open now · until ' + t12(h[1]);
    } else if (h && today.time < h[0]) {
      text = 'Closed · opens at ' + t12(h[0]) + ' today';
    } else {
      for (var i = 1; i <= 7; i++) {
        var next = parts(new Date(now.getTime() + i * 864e5));
        var nh = hoursFor(next);
        if (nh) { text = 'Closed · opens ' + (i === 1 ? 'tomorrow' : next.day) + ' at ' + t12(nh[0]); break; }
      }
    }
    var el = document.querySelector('[data-status]');
    if (el && text) {
      el.querySelector('[data-status-text]').textContent = text;
      el.classList.toggle('is-open', open);
      el.hidden = false;
    }
    var row = document.querySelector('[data-date="' + today.date + '"]') || document.querySelector('[data-day="' + today.day + '"]');
    if (row) row.classList.add('is-today');
  })();
</script>

<style>
  /* Hero */
  .vhero { padding-top: clamp(48px, 7vw, 88px); }
  .vhero__grid { display: grid; gap: 28px; align-items: end; padding-bottom: clamp(32px, 4vw, 48px); }
  .vhero__head { display: flex; flex-direction: column; gap: 20px; }
  .vhero__side { display: flex; flex-direction: column; gap: 18px; }
  .vhero__title { font-size: clamp(54px, 6.5vw, 84px); }
  .vhero__address { font-style: normal; font-size: 15px; line-height: 1.7; letter-spacing: 0.14em; }
  .vhero__intro { font-size: 18px; line-height: 1.6; color: var(--ink-soft); max-width: 30em; }
  .vhero__buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .btn--ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--ink); }
  .btn--ghost:hover { background: var(--ink); color: #fff; }
  @media (min-width: 1000px) {
    .vhero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 460px); gap: 64px; }
  }
  /* The whole street on wide screens; zoom in on the shop on phones. */
  .vhero__art { background: var(--stone); }
  .vhero__art :global(img) { width: 100%; height: auto; max-height: 720px; object-fit: cover; object-position: 43% 50%; }
  @media (max-width: 700px) {
    .vhero__art :global(img) { aspect-ratio: 4 / 3; height: auto; }
  }

  .status { display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; padding: 8px 14px; font-size: 15px; font-weight: 700; background: var(--stone-2); }
  .status[hidden] { display: none; }
  .status__dot { width: 10px; height: 10px; border-radius: 50%; background: #9a958c; }
  .status.is-open { background: #e3f3e6; color: #14532d; }
  .status.is-open .status__dot { background: #1f9d48; }

  /* Hours and contact */
  .info { background: var(--stone); padding-block: var(--section); }
  .info__grid { display: grid; gap: 56px; }
  @media (min-width: 900px) { .info__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 96px; } }
  .info__title { font-size: 15px; margin-bottom: 18px; }
  .week { margin: 0; font-size: 17px; }
  .week__row { display: flex; justify-content: space-between; gap: 16px; padding: 13px 12px; border-bottom: 1px solid var(--rule); }
  .week dt, .week dd { margin: 0; }
  .week dd { font-weight: 700; white-space: nowrap; }
  .week__today { display: none; margin-left: 10px; font-size: 10px; padding: 3px 7px; background: var(--ink); color: #fff; vertical-align: 2px; }
  .week__row.is-today { background: #fff; border-bottom-color: transparent; box-shadow: inset 3px 0 0 var(--accent); }
  .week__row.is-today .week__today { display: inline-block; }
  .special { margin-top: 36px; }
  .special__title { font-size: 12px; color: var(--accent-text); margin-bottom: 6px; }
  .special__when { color: var(--muted); font-size: 14px; margin-left: 6px; }

  .contact { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; font-size: 17px; }
  .contact li { display: flex; align-items: center; gap: 14px; }
  .contact a { text-underline-offset: 4px; }
  .xnote { margin-top: 32px; padding: 20px 22px; background: #fff; border-left: 3px solid var(--accent); display: flex; flex-direction: column; gap: 6px; font-size: 16px; line-height: 1.55; }
  .xnote__title { font-size: 12px; color: var(--accent-text); }
  .socials { margin-top: 32px; display: flex; flex-direction: column; gap: 10px; }
  .socials__title { font-size: 12px; color: var(--muted); }
  .socials__links { display: flex; gap: 8px; }
  .socials__links a { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border: 1.5px solid var(--ink); border-radius: 50%; }

  /* Map */
  .map { padding-top: var(--section); }
  .map__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 28px; }
  .map__links { display: flex; gap: 24px; }
  .map__links .text-link { font-size: 13px; }
  .map__frame { display: block; width: 100%; height: clamp(320px, 45vw, 480px); border: 0; border-block: 1px solid var(--stone-2); filter: grayscale(0.35); }
  .map__credit { font-size: 12px; color: var(--muted); padding-block: 8px; }

  /* Getting here */
  .here { padding-block: var(--section); }
  .here__grid { display: grid; gap: 56px; }
  @media (min-width: 900px) { .here__grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 80px; } }
  .here__title { margin-bottom: 32px; }
  .routes { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .route { display: flex; flex-direction: column; gap: 10px; border-top: 2px solid var(--ink); padding-top: 20px; }
  .route__label { font-size: 14px; }
  .route p { font-size: 16px; line-height: 1.55; color: var(--ink-soft); }
  .know__list { list-style: none; margin: 0; padding: 0; }
  .know__list li { padding: 12px 0; border-bottom: 1px solid var(--rule); font-size: 17px; }
  .know__list li::before { content: '✓'; margin-right: 12px; color: var(--accent-text); font-weight: 700; }
</style>
