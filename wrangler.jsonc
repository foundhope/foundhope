// Cloudflare Workers settings. The site is static: Cloudflare serves the built
// files in dist/, including _redirects and _headers. worker/index.ts only runs
// for the paths in run_worker_first: the Studio, and /api for Stripe deposits.
{
  "name": "foundhope",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/studio", "/studio/*", "/api/*"]
  },
  // Rebuild every night at 3am UK winter time (2am in summer)
  "triggers": { "crons": ["0 3 * * *"] }
}
