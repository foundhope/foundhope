// Cloudflare Workers settings. The site is fully static: Cloudflare serves the
// built files in dist/, including _redirects and _headers.
{
  "name": "foundhope",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
